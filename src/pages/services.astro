---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/astro/layout/CTASection.astro';
import content from '../data/content.json';

const services = [...content.services].sort((a, b) => a.order - b.order);
const { servicesPage } = content;
---

<BaseLayout title={servicesPage.seo.title} description={servicesPage.seo.description}>
  <section class="py-24 border-b border-ink-800">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl mb-24 text-center mx-auto">
        <span class="font-mono text-[12px] tracking-[0.2em] text-ink-300 uppercase mb-4 block">
          {servicesPage.eyebrow}
        </span>
        <h1
          class="font-brand text-5xl md:text-6xl font-semibold tracking-[-0.045em] text-paper mb-6"
        >
          {servicesPage.headline}
        </h1>
        <p class="text-[17px] leading-relaxed text-ink-300">
          {servicesPage.body}
        </p>
      </div>

      <div class="flex flex-col gap-24">
        {
          services.map((service, index) => (
            <div
              id={service.id}
              class="scroll-mt-28 grid grid-cols-1 lg:grid-cols-12 gap-12 border-t border-ink-800 pt-16 group"
            >
              <div class="lg:col-span-5">
                <div class="flex items-center gap-4 mb-6">
                  <span class="text-3xl font-brand font-semibold text-ink-300">0{index + 1}.</span>
                </div>
                <h2 class="font-brand text-[29px] md:text-[38px] leading-[1.1] font-semibold tracking-[-0.025em] text-paper group-hover:text-ink-100 transition-colors mb-6">
                  {service.title}
                </h2>
                <p class="text-[15px] leading-relaxed text-ink-300 mb-8">{service.description}</p>
              </div>

              <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-8">
                {service.deliverables && (
                  <div class="border border-ink-800 p-6">
                    <h3 class="font-mono text-[11px] tracking-[0.2em] text-ink-300 uppercase mb-6 pb-2 border-b border-ink-800">
                      Core Deliverables
                    </h3>
                    <ul class="flex flex-col gap-2.5">
                      {service.deliverables.map((item) => (
                        <li class="border-l border-ink-700 pl-3 text-[15px] leading-snug text-ink-200">
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {service.process && (
                  <div class="border border-ink-800 p-6">
                    <h3 class="font-mono text-[11px] tracking-[0.2em] text-ink-300 uppercase mb-6 pb-2 border-b border-ink-800">
                      Our Process
                    </h3>
                    <ul class="flex flex-col gap-2.5">
                      {service.process.map((step, idx) => (
                        <li class="flex gap-3 text-[15px] leading-snug text-ink-200">
                          <span class="font-mono text-[11px] text-ink-300">
                            {String(idx + 1).padStart(2, '0')}
                          </span>
                          {step}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
