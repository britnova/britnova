---
import BaseLayout from '../layouts/BaseLayout.astro';
import BriefForm from '../components/react/BriefForm';
import { Mail, MapPin, Globe, MessageCircle } from 'lucide-react';
import content from '../data/content.json';

const { contactPage } = content;
const email = content.site.email;
// The email row has no value/href of its own in content.json — it's keyed
// "email" and resolved here from `site.email`, the single source of truth.
const info = contactPage.info.map((item) =>
  item.key === 'email' ? { ...item, value: email, href: `mailto:${email}` } : item
);

const infoIcons = {
  email: Mail,
  whatsappUk: MessageCircle,
  whatsappPk: MessageCircle,
  location: MapPin,
  hours: Globe,
};
---

<BaseLayout title={contactPage.seo.title} description={contactPage.seo.description}>
  <section class="border-t border-ink-800">
    <div class="mx-auto max-w-[1500px] px-6 py-20 md:px-10 md:py-24">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Left Side: Contact Information -->
        <div class="flex h-full flex-col justify-between lg:col-span-5">
          <div>
            <p class="mb-6 font-mono text-[12px] tracking-[0.2em] text-ink-300 uppercase">
              {contactPage.eyebrow}
            </p>
            <h1
              class="font-brand max-w-[14ch] text-[10.2vw] leading-[0.98] font-semibold tracking-[-0.045em] text-paper md:text-[4.7vw]"
            >
              {contactPage.headline.line1}
              <br />
              {`${contactPage.headline.line2Prefix} ${contactPage.headline.accent}.`}
            </h1>
            <p class="mt-6 max-w-sm text-[17px] leading-relaxed text-ink-300">
              {contactPage.body}
            </p>
          </div>

          <!-- Contact items -->
          <div class="mt-12 space-y-6">
            {
              info.map((item) => {
                const Icon = infoIcons[item.key as keyof typeof infoIcons];
                return (
                  <div class="flex items-start gap-4">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm border border-ink-700 text-ink-300">
                      <Icon className="h-4 w-4" />
                    </div>
                    <div>
                      <span class="block font-mono text-[11px] tracking-[0.2em] text-ink-300 uppercase">
                        {item.label}
                      </span>
                      {'href' in item && item.href ? (
                        <a
                          href={item.href}
                          class="font-mono text-[15px] text-ink-100 transition-colors hover:text-paper"
                        >
                          {item.value}
                        </a>
                      ) : (
                        <span class="font-mono text-[15px] text-ink-100">{item.value}</span>
                      )}
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>

        <!-- Right Side: Contact Form Island -->
        <div class="lg:col-span-7">
          <BriefForm client:visible />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
