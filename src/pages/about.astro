---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/astro/CTASection.astro';
import content from '../data/content.json';

const { about } = content;
---

<BaseLayout title={about.seo.title} description={about.seo.description}>
  <!-- Hero Section -->
  <section class="py-24 border-b border-border-subtle bg-bg-dark text-text-light">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl mb-20">
        <span class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 block"
          >{about.eyebrow}</span
        >
        <h1
          class="font-display text-5xl md:text-7xl font-black uppercase tracking-tight text-text-light mb-8"
        >
          {about.headline.prefix}{' '}
          <span class="text-brand-accent">{about.headline.accent}</span>
        </h1>
        <p class="text-lg md:text-xl text-text-muted font-light leading-relaxed">
          {about.intro}
        </p>
      </div>

      <!-- Story grid -->
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start py-16 border-t border-border-subtle"
      >
        <!-- Left Title -->
        <div class="lg:col-span-4">
          <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-text-light">
            {about.story.title}
          </h2>
        </div>

        <!-- Right Paragraphs -->
        <div class="lg:col-span-8 space-y-6 text-sm text-text-muted leading-relaxed font-light">
          {about.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <!-- Values Grid -->
      <div class="py-20 border-t border-border-subtle">
        <div class="mb-12">
          <span class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 block"
            >{about.philosophy.eyebrow}</span
          >
          <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-text-light">
            {about.philosophy.title}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            about.philosophy.beliefs.map((belief, index) => (
              <div class="p-6 rounded-2xl bg-bg-card border border-border-subtle hover:border-brand-accent/30 transition-all duration-300">
                <div class="font-mono text-xs text-brand-accent mb-4">0{index + 1}.</div>
                <h3 class="font-display text-lg font-bold text-text-light uppercase tracking-tight mb-2">
                  {belief.title}
                </h3>
                <p class="text-xs text-text-muted leading-relaxed font-light">{belief.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA section -->
  <CTASection />
</BaseLayout>
