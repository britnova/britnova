---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/astro/CTASection.astro';
import SectionHeading from '../components/astro/home/SectionHeading.astro';
import content from '../data/content.json';

const { about } = content;
---

<BaseLayout title={about.seo.title} description={about.seo.description}>
  <!-- Hero Section -->
  <section class="border-b border-ink-800 py-24">
    <div class="mx-auto max-w-7xl px-6 md:px-12">
      <div class="mb-20 max-w-3xl">
        <span class="mb-5 block font-mono text-[12px] tracking-[0.2em] text-ink-300 uppercase">
          {about.eyebrow}
        </span>
        <h1
          class="font-brand max-w-[20ch] text-[42px] leading-[1.05] font-semibold tracking-[-0.045em] text-paper md:text-[68px]"
        >
          {`${about.headline.prefix} ${about.headline.accent}`}
        </h1>
        <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-ink-300">
          {about.intro}
        </p>
      </div>

      <!-- Story grid -->
      <div
        class="grid grid-cols-1 items-start gap-12 border-t border-ink-800 py-16 lg:grid-cols-12"
      >
        <!-- Left Title -->
        <div class="lg:col-span-4">
          <h2 class="font-mono text-[12px] tracking-[0.24em] text-ink-300 uppercase">
            {about.story.title}
          </h2>
        </div>

        <!-- Right Paragraphs -->
        <div class="space-y-6 text-[15px] leading-relaxed text-ink-300 lg:col-span-8">
          {about.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <!-- Values Grid -->
      <div class="border-t border-ink-800 py-20">
        <SectionHeading
          label={`${about.philosophy.eyebrow} / ${String(about.philosophy.beliefs.length).padStart(2, '0')}`}
        />
        <h3
          class="font-brand text-[28px] leading-[1.1] font-medium tracking-[-0.025em] text-paper md:text-[36px]"
        >
          {about.philosophy.title}
        </h3>

        <div
          class="mt-12 grid grid-cols-1 border-t border-l border-ink-800 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            about.philosophy.beliefs.map((belief, index) => (
              <div class="border-r border-b border-ink-800 p-6 md:p-7">
                <span class="font-mono text-[12px] text-ink-300">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="font-brand mt-3.5 text-[19px] leading-tight font-medium tracking-[-0.01em] text-paper">
                  {belief.title}
                </h3>
                <p class="mt-2.5 text-[15px] leading-relaxed text-ink-300">{belief.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA section -->
  <CTASection />
</BaseLayout>
