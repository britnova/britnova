---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/astro/CTASection.astro';

const beliefs = [
  { title: "Solve Real Problems", desc: "Technology should serve the business goals, not the other way around. We focus on outcomes." },
  { title: "Simplicity Over Complexity", desc: "We design modular, readable architectures that are easy to maintain and scale." },
  { title: "Scalability from Day One", desc: "Infrastructure and database schemas are built to endure traffic growth without rewrites." },
  { title: "Partnerships Over Projects", desc: "We act as your dedicated engineering arm, collaborating closely to launch products." }
];
---

<BaseLayout
  title="About Us | Britnova Technologies"
  description="Our story, core engineering values, and what drives our technological selections."
>
  <!-- Hero Section -->
  <section class="py-24 border-b border-border-subtle bg-bg-dark text-text-light">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl mb-20">
        <span class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 block">About Our Agency</span>
        <h1 class="font-display text-5xl md:text-7xl font-black uppercase tracking-tight text-text-light mb-8">
          About <span class="text-brand-accent">Britnova</span>
        </h1>
        <p class="text-lg md:text-xl text-text-muted font-light leading-relaxed">
          We are a forward-thinking technology company helping businesses build scalable digital products using AI, cloud, and modern web technologies.
        </p>
      </div>

      <!-- Story grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start py-16 border-t border-border-subtle">
        
        <!-- Left Title -->
        <div class="lg:col-span-4">
          <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-text-light">
            Our Story
          </h2>
        </div>

        <!-- Right Paragraphs -->
        <div class="lg:col-span-8 space-y-6 text-sm text-text-muted leading-relaxed font-light">
          <p>
            Britnova Technologies was founded with a simple vision — to bridge the gap between complex, emerging technology and tangible business value. We noticed that many companies were either getting lost in AI hype or running fragile legacy systems that bottlenecked growth.
          </p>
          <p>
            We specialize in AI/ML model deployment, DevOps pipeline automations, and modern full-stack development, delivering engineering solutions that are not only powerful but also scalable and maintainable.
          </p>
          <p>
            From startups launching their first products to growing enterprises modernizing their tech stack, we work side-by-side with product teams to turn technical concepts into production-ready software.
          </p>
        </div>

      </div>

      <!-- Values Grid -->
      <div class="py-20 border-t border-border-subtle">
        <div class="mb-12">
          <span class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 block">Our Philosophy</span>
          <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-text-light">
            What We Believe
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {beliefs.map((belief, index) => (
            <div class="p-6 rounded-2xl bg-bg-card border border-border-subtle hover:border-brand-accent/30 transition-all duration-300">
              <div class="font-mono text-xs text-brand-accent mb-4">0{index + 1}.</div>
              <h3 class="font-display text-lg font-bold text-text-light uppercase tracking-tight mb-2">
                {belief.title}
              </h3>
              <p class="text-xs text-text-muted leading-relaxed font-light">
                {belief.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA section -->
  <CTASection />
</BaseLayout>
