---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkGridFilters from '../../components/react/WorkGridFilters';
import CTASection from '../../components/astro/shared/CTASection.astro';
import content from '../../data/content.json';

const caseStudies = content.work;
const { workPage } = content;
---

<BaseLayout title={workPage.seo.title} description={workPage.seo.description}>
  <section class="py-24 border-b border-ink-800">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl mb-20 text-center mx-auto">
        <p class="mb-4 font-mono text-[12px] tracking-[0.2em] text-ink-300 uppercase">
          {workPage.eyebrow}
        </p>
        <h1
          class="font-brand text-[40px] leading-[1.05] font-semibold tracking-[-0.045em] text-paper md:text-[56px]"
        >
          {workPage.headline}
        </h1>
        <p class="mt-6 text-[17px] leading-relaxed text-ink-300">
          {workPage.body}
        </p>
      </div>

      <WorkGridFilters client:visible caseStudies={caseStudies} />
    </div>
  </section>

  <!-- CTA section -->
  <CTASection />
</BaseLayout>
