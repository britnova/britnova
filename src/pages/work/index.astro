---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkGridFilters from '../../components/react/WorkGridFilters';
import CTASection from '../../components/astro/CTASection.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const caseStudies = allWork.map((item) => ({
  title: item.data.title,
  description: item.data.description,
  slug: item.id,
  tags: item.data.tags,
  client: item.data.client,
  year: item.data.year,
}));
---

<BaseLayout
  title="Our Portfolio | Britnova Technologies"
  description="Explore our case studies in custom AI models, infrastructure automation, full-stack systems, and cloud migrations."
>
  <section class="py-24 border-b border-border-subtle bg-bg-dark">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <!-- Header -->
      <div class="max-w-3xl mb-20 text-center mx-auto">
        <span class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 block"
          >Our Work</span
        >
        <h1
          class="font-display text-5xl md:text-6xl font-black uppercase tracking-tight text-text-light mb-6"
        >
          Selected Case Studies
        </h1>
        <p class="text-text-muted text-lg font-light leading-relaxed">
          A deep dive into the systems we've designed, the pipelines we've automated, and the
          codebases we've scaled.
        </p>
      </div>

      <!-- Interactive Filters + Grid Island -->
      <WorkGridFilters client:load caseStudies={caseStudies} />
    </div>
  </section>

  <!-- CTA section -->
  <CTASection />
</BaseLayout>
