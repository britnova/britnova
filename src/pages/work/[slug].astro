---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../data/content.json';
import { ArrowLeft, ArrowRight } from 'lucide-react';

export async function getStaticPaths() {
  const workEntries = content.work;
  return workEntries.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      nextEntry: workEntries[(index + 1) % workEntries.length],
    },
  }));
}

const { entry, nextEntry } = Astro.props;
---

<BaseLayout title={`${entry.title} | Britnova Technologies`} description={entry.description}>
  <article class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Back Link -->
      <a
        href="/work"
        class="inline-flex items-center gap-2 font-mono text-[12px] tracking-[0.14em] text-ink-300 uppercase hover:text-paper transition-colors mb-12"
      >
        <ArrowLeft className="w-4 h-4" />
        Back to portfolio
      </a>

      <!-- Hero Image -->
      {
        entry.heroImage && (
          <div class="mb-12 aspect-[16/9] overflow-hidden border border-ink-800 bg-ink-900">
            <img
              src={entry.heroImage}
              alt={`${entry.title} homepage`}
              class="h-full w-full object-cover object-top"
            />
          </div>
        )
      }

      <!-- Header -->
      <div class="border-b border-ink-800 pb-12 mb-12">
        <span class="font-mono text-[12px] tracking-[0.2em] text-ink-300 uppercase block mb-4">
          Case Study
        </span>
        <h1
          class="font-brand text-[8vw] md:text-[4vw] font-semibold tracking-[-0.045em] text-paper mb-6 leading-[1.05]"
        >
          {entry.title}
        </h1>
        <p class="text-[17px] leading-relaxed text-ink-300 max-w-2xl mb-8">
          {entry.description}
        </p>

        <!-- Tags -->
        <div class="pt-6 border-t border-ink-800 text-sm">
          <span class="font-mono text-[11px] text-ink-300 block uppercase tracking-[0.14em] mb-1">
            Tags
          </span>
          <div class="flex flex-wrap gap-1.5 mt-1">
            {
              entry.tags.map((tag) => (
                <span class="border border-ink-700 px-2.5 py-0.5 font-mono text-[10px] tracking-[0.1em] text-ink-300 uppercase">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Metrics Highlight -->
      {
        entry.metrics && entry.metrics.length > 0 && (
          <div class="grid grid-cols-1 border-t border-l border-ink-800 sm:grid-cols-3 mb-16">
            {entry.metrics.map((metric) => (
              <div class="border-r border-b border-ink-800 p-6">
                <span class="font-brand text-[28px] md:text-[34px] font-semibold text-paper block mb-1">
                  {metric.value}
                </span>
                <span class="font-mono text-[10px] tracking-[0.12em] text-ink-300 uppercase">
                  {metric.label}
                </span>
              </div>
            ))}
          </div>
        )
      }

      <!-- Case Study Content -->
      <div class="max-w-none">
        {
          entry.sections.map((section) => (
            <>
              <h2 class="font-brand text-[26px] md:text-[32px] font-semibold tracking-[-0.02em] text-paper mt-12 mb-5 pb-3 border-b border-ink-800">
                {section.heading}
              </h2>
              {section.paragraphs.map((paragraph) => (
                <p class="text-[17px] leading-relaxed text-ink-300 mb-5">{paragraph}</p>
              ))}
            </>
          ))
        }
      </div>

      <!-- Next Project Link -->
      {
        nextEntry && (
          <div class="border-t border-ink-800 pt-16 mt-20">
            <span class="font-mono text-[12px] text-ink-300 uppercase tracking-[0.2em] block mb-4">
              Next Case Study
            </span>
            <a
              href={`/work/${nextEntry.slug}`}
              class="group flex justify-between items-center p-6 border border-ink-800 hover:border-ink-500 transition-colors"
            >
              <h4 class="font-brand text-[22px] md:text-[26px] font-semibold tracking-[-0.02em] text-paper">
                {nextEntry.title}
              </h4>
              <div class="w-10 h-10 border border-ink-700 group-hover:border-paper flex items-center justify-center text-ink-300 group-hover:text-paper transition-colors">
                <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
              </div>
            </a>
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>
