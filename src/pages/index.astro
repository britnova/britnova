---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/astro/Hero.astro';
import LogoStrip from '../components/astro/LogoStrip.astro';
import StatsRow from '../components/astro/StatsRow.astro';
import ServicesList from '../components/astro/ServicesList.astro';
import TestimonialCarousel from '../components/react/TestimonialCarousel';
import CTASection from '../components/astro/CTASection.astro';
import WorkCard from '../components/astro/WorkCard.astro';
import { getCollection } from 'astro:content';

const featuredWork = await getCollection('work', ({ data }) => {
  return data.featured === true;
});

// Limit to max 3 on home page
const workItems = featuredWork.slice(0, 3);
---

<BaseLayout
  title="Britnova Technologies | Intelligent AI, Cloud & Web Engineering"
  description="We design and build high-performance, scalable digital products using AI, Cloud, and modern web frameworks."
>
  <!-- Hero Section -->
  <Hero />

  <!-- Logo Strip -->
  <LogoStrip />

  <!-- Stats Row -->
  <StatsRow />

  <!-- Featured Work section -->
  <section id="work" class="py-28 border-b border-border-subtle bg-bg-dark">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6">
        <div class="max-w-xl">
          <span class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 block"
            >Case Studies</span
          >
          <h2
            class="font-display text-4xl md:text-5xl font-black uppercase tracking-tight text-text-light leading-tight"
          >
            Projects We've Brought to Life
          </h2>
        </div>
        <a
          href="/work"
          class="inline-flex items-center gap-1 text-sm font-semibold uppercase tracking-wider text-text-light border-b border-text-light pb-1 hover:text-brand-accent hover:border-brand-accent transition-colors self-start md:self-auto"
        >
          View All Projects
        </a>
      </div>

      <!-- Work Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          workItems.map((item) => (
            <WorkCard
              title={item.data.title}
              description={item.data.description}
              slug={item.id}
              tags={item.data.tags}
              client={item.data.client}
              year={item.data.year}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services List Section -->
  <ServicesList />

  <!-- Testimonials Carousel Section -->
  <TestimonialCarousel client:visible />

  <!-- CTA Section -->
  <CTASection />
</BaseLayout>
