---
/*
 * Homepage.
 *
 * Section order:
 *   Hero (full viewport, includes the header) → Why work with us → Services →
 *   Technology stack → How we work → Meet the team → Contact → Footer
 *
 * `chrome={false}` because this page supplies its own header and footer
 * directly (embedding SiteHeader inside Hero, so the two fill exactly one
 * viewport) rather than via BaseLayout's shared-chrome path.
 *
 * TODO: replace — the page still renders placeholder copy throughout, and the
 * team section contains no real people. Grep `TODO: replace` under
 * src/components/astro/home and src/data before launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/astro/home/Hero.astro';
import WhyUs from '../components/astro/home/WhyUs.astro';
import ServicesTabs from '../components/astro/home/ServicesTabs.astro';
import TechStackBelt from '../components/astro/home/TechStackBelt.astro';
import ProcessGrid from '../components/astro/home/ProcessGrid.astro';
import TeamRoster from '../components/astro/home/TeamRoster.astro';
import ContactSection from '../components/astro/home/ContactSection.astro';
import SiteFooter from '../components/astro/home/SiteFooter.astro';
import content from '../data/content.json';

const services = [...content.services].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="BritNova Tech | AI, Cloud & Web Engineering"
  description="An engineering studio working across machine learning, cloud infrastructure, delivery automation and the modern web."
  chrome={false}
>
  <div class="relative bg-ink-950 font-sans text-paper antialiased">
    {/* brand sheen, lifted from the banner asset */}
    <div aria-hidden="true" class="home-sheen pointer-events-none absolute inset-x-0 top-0"></div>

    <Hero />
    <WhyUs />
    <ServicesTabs services={services} />
    <TechStackBelt />
    <ProcessGrid />
    <TeamRoster />
    <ContactSection />
    <SiteFooter
      pagesLabel={content.home.footer.pagesLabel}
      pageLinks={content.home.footer.pageLinks}
    />
  </div>
</BaseLayout>

<style>
  /* Height must stay equal to the hero (one viewport, header included) or the
     gradient's bottom edge shows as a seam in the next section. The mask fades
     the last 45% so the boundary is invisible either way. */
  .home-sheen {
    height: 100dvh;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.09) 0%,
      rgba(255, 255, 255, 0) 28%,
      rgba(255, 255, 255, 0.05) 44%,
      rgba(255, 255, 255, 0) 62%,
      rgba(255, 255, 255, 0.07) 78%,
      rgba(255, 255, 255, 0) 100%
    );
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }
</style>
