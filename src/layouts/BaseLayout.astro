---
import '../styles/global.css';
import SiteHeader from '../components/astro/home/SiteHeader.astro';
import SiteFooter from '../components/astro/home/SiteFooter.astro';
import content from '../data/content.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /**
   * Render the shared SiteHeader + SiteFooter. Set false when the page
   * supplies its own chrome directly — the homepage does, embedding
   * SiteHeader inside Hero so the two fill exactly one viewport.
   */
  chrome?: boolean;
}

const {
  title = 'Britnova Technologies | Intelligent AI, Cloud & Web Engineering',
  description = 'We design and build high-performance, scalable digital products using AI, Cloud, and modern web frameworks.',
  ogImage = '/images/og-default.jpg',
  chrome = true,
} = Astro.props;

const { links: innerNavLinks, ctaLabel: innerCtaLabel } = content.layout.innerNav;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
  </head>
  <body
    class="bg-ink-950 text-paper font-sans flex flex-col min-h-screen selection:bg-paper selection:text-ink-950"
  >
    {chrome && <SiteHeader links={innerNavLinks} ctaLabel={innerCtaLabel} ctaHref="/contact" />}

    <main class="flex-grow">
      <slot />
    </main>

    {chrome && <SiteFooter links={innerNavLinks} copyrightName={content.site.legalName} />}
  </body>
</html>
