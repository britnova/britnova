---
import '../styles/global.css';
import Nav from '../components/react/Nav';
import Footer from '../components/astro/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /**
   * Render the shared Nav + Footer. Set false when the page supplies its own
   * chrome. The homepage sets this false — it supplies its own header and
   * footer in the monochrome brand palette, while the inner pages still use
   * the shared Nav/Footer.
   */
  chrome?: boolean;
}

const {
  title = 'Britnova Technologies | Intelligent AI, Cloud & Web Engineering',
  description = 'We design and build high-performance, scalable digital products using AI, Cloud, and modern web frameworks.',
  ogImage = '/images/og-default.jpg',
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
  </head>
  <body
    class="bg-bg-dark text-text-light font-sans flex flex-col min-h-screen selection:bg-brand-accent selection:text-bg-dark"
  >
    <!-- Sticky Nav -->
    {chrome && <Nav client:visible />}

    <!-- Main Content Area -->
    <main class={chrome ? 'flex-grow pt-20' : 'flex-grow'}>
      <slot />
    </main>

    <!-- Footer -->
    {chrome && <Footer />}
  </body>
</html>
