---
import '../styles/global.css';
import SiteHeader from '../components/astro/shared/SiteHeader.astro';
import SiteFooter from '../components/astro/shared/SiteFooter.astro';
import SiteThemeToggle from '../components/astro/shared/SiteThemeToggle.astro';
import { THEME_STORAGE_KEY } from '../utils/theme';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /**
   * Render the shared SiteHeader + SiteFooter. Set false when the page
   * supplies its own chrome directly — the homepage does, embedding
   * SiteHeader inside Hero so the two fill exactly one viewport.
   */
  chrome?: boolean;
}

const {
  title = 'Britnova Technologies | Intelligent AI, Cloud & Web Engineering',
  description = 'We design and build high-performance, scalable digital products using AI, Cloud, and modern web frameworks.',
  ogImage = '/images/og-default.jpg',
  chrome = true,
} = Astro.props;

/*
 * Umami (cloud) — cookieless analytics. The site ID is public by design: it
 * ships in the HTML of every page. Keeping it here rather than in astro:env
 * means one less host env var that can go missing silently.
 *
 * Production builds only, so `npm run dev` doesn't pollute the dashboard.
 */
const UMAMI_WEBSITE_ID = '3e7b9252-5cdd-4c78-894f-290d84599ec8';

/*
 * Plerdy — click heatmaps and session recording. Vendor snippet, byte-for-byte
 * as supplied. It lives here as a string and is injected with `set:html`
 * because Astro treats a <script> element's children as raw text: writing the
 * JS inline inside the conditional below emits the surrounding braces
 * literally, producing `{\`(function(){...})()\`}` — valid JS that parses as a
 * block wrapping an unused string, so the IIFE silently never runs.
 */
/*
 * The vendor code is unchanged; what changed is *when* it runs. Loaded at page
 * load, Plerdy's chain (a dozen scripts, ~147KB, cache-busted every view) cost
 * ~1.5s of main-thread blocking and dropped the PageSpeed score from 100 to
 * 72. It now waits for the first user gesture: a real visitor triggers it with
 * their first scroll, tap, click, key or mouse movement — moments into the
 * visit, before there is anything meaningful to record — while idle page loads
 * (and lab runs) never pay for it. A visitor who leaves without ever
 * interacting produces no heatmap data by definition, so nothing of value is
 * lost.
 */
const PLERDY_SNIPPET = `(function(){
  var arm=function(){
    removeEventListener("pointerdown",arm);removeEventListener("scroll",arm);
    removeEventListener("keydown",arm);removeEventListener("touchstart",arm);
    removeEventListener("mousemove",arm);
    (function(w,d){
      if(w.__plerdyCode)return;
      w.__plerdyCode=1;
      w._protocol=w.location.protocol=="https:"?"https://":"http://";
      w._site_hash_code="bdf2ef533b53e3a7323847be9d0c883c";
      w._suid=80623;
      var s=d.createElement("script");
      s.async=true;
      s.referrerPolicy="strict-origin-when-cross-origin";
      s.src="https://a.plerdy.com/public/js/click/main.js?v="+Math.random();
      d.head.appendChild(s);
    })(window,document);
  };
  addEventListener("pointerdown",arm,{passive:true});
  addEventListener("scroll",arm,{passive:true});
  addEventListener("keydown",arm,{passive:true});
  addEventListener("touchstart",arm,{passive:true});
  addEventListener("mousemove",arm,{passive:true});
})();`;
const analyticsEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!--
      Theme resolution — must run before first paint, so it's inline/blocking
      (`is:inline` stops Astro deferring it as a module) and placed first in
      <head>, ahead of anything that could paint. Stored choice wins; else
      system preference; else dark (the implicit default — see the
      [data-theme="light"] block in global.css, there's no explicit "dark"
      attribute value, absence of the attribute IS dark).
    -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function () {
        let stored = null;
        try {
          stored = localStorage.getItem(THEME_STORAGE_KEY);
        } catch {
          /* noop — falls through to system preference below */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        if (theme === 'light') document.documentElement.setAttribute('data-theme', 'light');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts are self-hosted (see @font-face in global.css), so nothing on the
         critical path touches a third-party origin.

         Every face the site can render is preloaded: Inter for body copy,
         Poppins 600 for the h1, 500 for section headings, 300/400/700 for the
         wordmark, and JetBrains Mono 400 for nav/eyebrows/buttons. With
         font-display: block a face that is discovered late (at style-match
         time, after the inlined CSS is parsed) becomes a critical-path fetch
         holding its text invisible; preloading moves that fetch to head parse,
         in parallel with everything else. -->
    <link
      rel="preload"
      href="/fonts/inter-300-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-300-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Pages can inject their own critical <head> tags here — /work uses it to
         preload its LCP image, which the browser otherwise cannot discover until
         it has laid the grid out. -->
    <slot name="head" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />

    {
      /* Analytics — `is:inline` keeps `defer` and `data-website-id` intact;
        without it Astro bundles the tag into a module and both are lost. */
    }
    {
      analyticsEnabled && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={UMAMI_WEBSITE_ID}
        />
      )
    }
  </head>
  <body
    class="bg-ink-950 text-paper font-sans flex flex-col min-h-screen selection:bg-paper selection:text-ink-950"
  >
    {chrome && <SiteHeader />}

    <main class="flex-grow">
      <slot />
    </main>

    {chrome && <SiteFooter />}

    {
      /* Unconditional — unlike SiteHeader/SiteFooter, this isn't page chrome
       the homepage supplies itself; it's a fixed overlay every page needs. */
    }
    <SiteThemeToggle />

    {
      /* `is:inline` for the same reason as the Umami tag: without it Astro
        bundles this as a module and the `data-plerdy_code` attribute the
        vendor's loader looks for is lost. Gated on PROD to match Umami, so
        `pnpm dev` doesn't record local sessions into the dashboard. */
    }
    {analyticsEnabled && <script is:inline data-plerdy_code="1" set:html={PLERDY_SNIPPET} />}
  </body>
</html>
