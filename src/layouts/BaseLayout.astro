---
import '../styles/global.css';
import SiteHeader from '../components/astro/shared/SiteHeader.astro';
import SiteFooter from '../components/astro/shared/SiteFooter.astro';
import SiteThemeToggle from '../components/astro/shared/SiteThemeToggle.astro';
import { THEME_STORAGE_KEY } from '../utils/theme';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /**
   * Render the shared SiteHeader + SiteFooter. Set false when the page
   * supplies its own chrome directly — the homepage does, embedding
   * SiteHeader inside Hero so the two fill exactly one viewport.
   */
  chrome?: boolean;
}

const {
  title = 'Britnova Technologies | Intelligent AI, Cloud & Web Engineering',
  description = 'We design and build high-performance, scalable digital products using AI, Cloud, and modern web frameworks.',
  ogImage = '/images/og-default.jpg',
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!--
      Theme resolution — must run before first paint, so it's inline/blocking
      (`is:inline` stops Astro deferring it as a module) and placed first in
      <head>, ahead of anything that could paint. Stored choice wins; else
      system preference; else dark (the implicit default — see the
      [data-theme="light"] block in global.css, there's no explicit "dark"
      attribute value, absence of the attribute IS dark).
    -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (function () {
        let stored = null;
        try {
          stored = localStorage.getItem(THEME_STORAGE_KEY);
        } catch {
          /* noop — falls through to system preference below */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        if (theme === 'light') document.documentElement.setAttribute('data-theme', 'light');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
  </head>
  <body
    class="bg-ink-950 text-paper font-sans flex flex-col min-h-screen selection:bg-paper selection:text-ink-950"
  >
    {chrome && <SiteHeader />}

    <main class="flex-grow">
      <slot />
    </main>

    {chrome && <SiteFooter />}

    {
      /* Unconditional — unlike SiteHeader/SiteFooter, this isn't page chrome
       the homepage supplies itself; it's a fixed overlay every page needs. */
    }
    <SiteThemeToggle />
  </body>
</html>
