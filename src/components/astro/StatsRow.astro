---
const stats = [
  { value: '50+', label: 'Projects Completed' },
  { value: '10+', label: 'Enterprise Partners' },
  { value: '99%', label: 'Client Satisfaction' },
  { value: '8+', label: 'Avg Weeks to Launch' },
];
---

<section class="py-20 border-b border-border-subtle bg-bg-dark">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div
      class="grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-6 divide-y lg:divide-y-0 lg:divide-x divide-border-subtle"
    >
      {
        stats.map((stat, index) => (
          <div
            class={`text-center flex flex-col items-center justify-center ${index > 1 ? 'pt-8 lg:pt-0' : ''} ${index > 0 && index <= 1 ? 'lg:pt-0' : ''}`}
          >
            <div class="font-display text-5xl md:text-6xl font-extrabold text-brand-accent tracking-tight mb-2 select-none">
              {stat.value}
            </div>
            <div class="font-mono text-xs uppercase tracking-widest text-text-muted">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
