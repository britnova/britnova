---
/*
 * Shared closing CTA — appears at the bottom of About, Services, and Work.
 * Monochrome register, matching the homepage's SectionHeading/button
 * patterns: no accent color, sharp/rounded-sm buttons, no decorative glow.
 */
import content from '../../../data/content.json';

const { cta } = content.layout;
---

<section class="relative z-10 border-t border-ink-800">
  <div
    class="mx-auto flex max-w-[1500px] flex-col items-center px-6 py-24 text-center md:px-10 md:py-32"
  >
    <p class="mb-6 font-mono text-[12px] tracking-[0.2em] text-ink-300 uppercase">
      {cta.eyebrow}
    </p>

    <h2
      class="font-brand max-w-3xl text-[11vw] leading-[0.98] font-semibold tracking-[-0.045em] text-paper sm:text-[9vw] md:text-[5.4vw]"
    >
      {cta.headlineLine1}
      <br />
      {cta.headlineLine2}
    </h2>

    <p class="mt-7 max-w-xl text-[17px] leading-relaxed text-ink-300">
      {cta.body}
    </p>

    <div class="mt-10 flex flex-col items-center gap-2.5 sm:flex-row">
      <a
        href={cta.primary.href}
        class="rounded-sm bg-paper px-7 py-3.5 font-mono text-[12px] tracking-[0.14em] text-ink-950 uppercase transition-colors hover:bg-ink-200"
      >
        {cta.primary.label}
      </a>
      <a
        href={cta.secondary.href}
        class="rounded-sm border border-ink-500 px-7 py-3.5 font-mono text-[12px] tracking-[0.14em] text-ink-100 uppercase transition-colors hover:border-ink-200 hover:text-paper"
      >
        {cta.secondary.label}
      </a>
    </div>
  </div>
</section>
