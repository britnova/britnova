---
/*
 * Site footer — one block, two lines, identical on every page:
 *   logo ............................ social icons
 *   © legal name ......... legal pages + analytics on/off switch
 * The analytics switch is wired up by src/utils/analytics.ts.
 */
import BrandLogo from './BrandLogo.astro';
import SocialIcon from './SocialIcon.astro';
import content from '../../../data/content.json';

type SocialIconName = 'linkedin' | 'instagram';

// Short form keeps the copyright on one line on phones; the full registered
// name stays on /privacy, where the data controller has to be identified.
const { legalNameShort } = content.site;
const { legalLinks, social, socialLabel, newTab } = content.footer;
const { labelOn } = content.analytics;

// Same active-page rule as SiteHeader: the current page renders as plain
// text (nothing to navigate to), everything else as a link.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const path = href.replace(/\/$/, '') || '/';
  return path === '/'
    ? currentPath === '/'
    : currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<footer class="relative z-10 border-t border-ink-800">
  <div
    class="mx-auto flex max-w-[1500px] flex-col gap-3 px-6 py-7 font-mono text-[11px] tracking-[0.12em] text-ink-300 uppercase md:px-10"
  >
    <div class="flex items-center justify-between gap-6">
      <span class="font-sans text-[15px] tracking-normal normal-case"><BrandLogo /></span>
      {
        /* -mr cancels the icons' tap padding so their edge lines up with the legal
        row; gap + that padding leaves 16px between "Follow Us" and the first icon. */
      }
      <div class="-mr-[7px] flex items-center gap-[9px]">
        <p id="footer-social-label" class="text-ink-200">{socialLabel}</p>
        <ul class="flex items-center gap-1" aria-labelledby="footer-social-label">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex p-[7px] text-ink-300 transition-colors hover:text-paper"
                >
                  <SocialIcon name={s.icon as SocialIconName} />
                  <span class="sr-only">{`${s.label} ${newTab}`}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* The legal name + legal row need ~870px side by side; narrower screens stack them. */}
    <div
      class="flex flex-col gap-3 min-[900px]:flex-row min-[900px]:items-center min-[900px]:justify-between"
    >
      <p>{`© ${new Date().getFullYear()} ${legalNameShort}`}</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Legal">
          {
            legalLinks.map((l) =>
              isActive(l.href) ? (
                <span aria-current="page" class="text-paper">
                  {l.label}
                </span>
              ) : (
                <a href={l.href} class="text-ink-300 transition-colors hover:text-paper">
                  {l.label}
                </a>
              )
            )
          }
        </nav>
        <button
          type="button"
          data-analytics-toggle
          class="uppercase text-ink-300 transition-colors hover:text-paper"
        >
          {labelOn}
        </button>
      </div>
    </div>
  </div>
</footer>
