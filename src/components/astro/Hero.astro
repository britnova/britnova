---
import { ArrowUpRight } from 'lucide-react';
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden border-b border-border-subtle py-24 px-6">
  <!-- Dynamic glow circles -->
  <div class="absolute top-[20%] left-[15%] w-96 h-96 rounded-full bg-brand-accent/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-[20%] right-[15%] w-96 h-96 rounded-full bg-brand-accent/5 blur-[120px] pointer-events-none"></div>

  <!-- Editorial background grid overlay -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#141414_1px,transparent_1px),linear-gradient(to_bottom,#141414_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] pointer-events-none opacity-40"></div>

  <div class="relative z-10 max-w-5xl mx-auto text-center flex flex-col items-center">
    <!-- Subtle Tagline -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-border-subtle bg-bg-card text-xs font-mono text-text-muted mb-8 tracking-wider uppercase">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-accent animate-pulse"></span>
      Next-Gen Digital Studio
    </div>

    <!-- Main Title -->
    <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[0.9] text-text-light mb-8 max-w-4xl uppercase select-none">
      Engineering the <br/>
      Future with <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-accent via-indigo-400 to-brand-accent bg-[size:200%_auto] hover:animate-[shine_3s_linear_infinite]">Intelligence</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-text-muted max-w-2xl leading-relaxed mb-12 font-light">
      We design intelligent systems, scalable cloud infrastructure, and modern web applications that drive real business impact.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="/contact"
        class="group inline-flex items-center gap-2 bg-brand-accent text-bg-dark font-semibold px-8 py-4 rounded-full hover:bg-brand-accent/90 transition-all duration-300 shadow-[0_4px_20px_rgba(108,92,231,0.25)]"
      >
        Get in Touch
        <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" />
      </a>
      <a
        href="#work"
        class="inline-flex items-center gap-2 text-sm font-semibold text-text-light border border-border-subtle hover:border-text-light px-8 py-4 rounded-full transition-all duration-300 bg-bg-dark/50 backdrop-blur-sm"
      >
        View Work
      </a>
    </div>
  </div>
</section>
