---
/*
 * Site footer — the same nav links as SiteHeader, one row, identical on
 * every page. No secondary/"more" row: there's nothing left to link to that
 * isn't already in the primary row.
 */
import BrandLogo from './BrandLogo.astro';
import content from '../../../data/content.json';

const { links } = content.nav;
const { legalName } = content.site;
---

<footer class="relative z-10 border-t border-ink-800">
  <div
    class="mx-auto flex max-w-[1500px] flex-col gap-4 px-6 py-7 font-mono text-[11px] tracking-[0.12em] text-ink-300 uppercase md:flex-row md:items-center md:justify-between md:px-10"
  >
    <span class="font-sans text-[15px] tracking-normal text-ink-300 normal-case">
      <BrandLogo id="footer" />
    </span>
    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class="text-ink-300 transition-colors hover:text-paper">
            {l.label}
          </a>
        ))
      }
    </nav>
    <p>© {new Date().getFullYear()} {legalName}</p>
  </div>
</footer>
