---
/*
 * "Why work with us" — a positioning statement beside a checklist of value
 * propositions.
 *
 * TODO: replace — every line is placeholder. The props follow the brief's own
 * advice: no years-in-business, client counts, logos or awards, because none
 * of those are verified. See src/data/content.json.
 */
import SectionHeading from './SectionHeading.astro';
import content from '../../../data/content.json';

const { whyUs } = content.home;
---

<section id="why" class="relative z-10 border-t border-ink-800">
  <div class="mx-auto max-w-[1500px] px-6 py-20 md:px-10 md:py-24">
    <SectionHeading
      id="why"
      label={`Why work with us / ${String(whyUs.items.length).padStart(2, '0')}`}
    />
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      {/* TODO: replace — placeholder statement */}
      <h3
        class="font-brand max-w-[14ch] text-[34px] leading-[1.06] font-medium tracking-[-0.03em] text-paper md:col-span-5 md:text-[45px]"
      >
        {whyUs.headline}
      </h3>
      <ul class="flex flex-col gap-5 md:col-span-6 md:col-start-7">
        {
          whyUs.items.map((w) => (
            <li class="flex gap-4 border-b border-ink-800 pb-5 last:border-b-0">
              <span aria-hidden="true" class="font-mono text-[14px] text-ink-300">
                →
              </span>
              <div>
                <span class="font-mono text-[14px] tracking-[0.08em] text-ink-100 uppercase">
                  {w.title}
                </span>
                <p class="mt-1 text-[15px] leading-relaxed text-ink-300">{w.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
