---
/*
 * "Contact" — the homepage's closing section.
 *
 * Headline and direct channels on the left, the brief form on the right. The
 * form is the only client-side island on the page (`client:visible`, since it
 * is below the fold) and posts to the existing Resend endpoint.
 *
 * TODO: replace — the copy is placeholder, and every channel except the email
 * address is unresolved. Do NOT invent Calendly / LinkedIn / WhatsApp URLs;
 * fill in the real ones or delete those rows.
 *
 * The email channel has no value/href of its own in content.json — it's
 * keyed "email" and resolved below from `site.email`, the single source of
 * truth for the address, so the same channel with no href renders as inert
 * text, never as a dead link.
 */
import BriefForm from '../../react/BriefForm';
import content from '../../../data/content.json';

const { eyebrow, headline, body, channels, location } = content.home.contact;
const email = content.site.email;
const resolvedChannels = channels.map((c) =>
  c.key === 'email' ? { ...c, value: email, href: `mailto:${email}` } : c
);
---

<section id="contact" class="relative z-10 border-t border-ink-800">
  <div class="mx-auto max-w-[1500px] px-6 py-20 md:px-10 md:py-28">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:items-start md:gap-12">
      <div>
        <div>
          <p class="mb-6 font-mono text-[12px] tracking-[0.2em] text-ink-300 uppercase">
            {eyebrow}
          </p>
          <h2
            class="font-brand max-w-[14ch] text-[10.2vw] leading-[0.98] font-semibold tracking-[-0.045em] text-paper md:text-[4.2vw]"
          >
            <a href="#contact" class="transition-colors hover:text-ink-200">{headline}</a>
          </h2>

          <p class="mt-6 max-w-md text-[17px] leading-relaxed text-ink-300">
            {body}
          </p>
        </div>

        <div class="mt-10 border border-ink-800 bg-ink-900/60 px-5 md:px-6">
          {
            resolvedChannels.map((c) => {
              const Row = c.href ? 'a' : 'div';
              return (
                <Row
                  href={c.href}
                  class="group flex items-baseline justify-between gap-6 border-b border-ink-800 py-4"
                >
                  <span class="shrink-0 font-mono text-[11px] tracking-[0.2em] text-ink-300 uppercase">
                    {c.label}
                  </span>
                  <span
                    class={
                      c.href
                        ? 'min-w-0 shrink break-words text-right font-mono text-[15px] tracking-[0.04em] text-ink-100 transition-colors group-hover:text-paper'
                        : 'min-w-0 shrink break-words text-right font-mono text-[15px] tracking-[0.04em] text-ink-300'
                    }
                  >
                    {c.value}
                    {c.href && (
                      <span
                        aria-hidden="true"
                        class="inline-block text-ink-300 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-paper"
                      >
                        {' '}
                        ↗
                      </span>
                    )}
                  </span>
                </Row>
              );
            })
          }

          <div class="flex items-baseline justify-between gap-6 py-4">
            <span class="shrink-0 font-mono text-[11px] tracking-[0.2em] text-ink-300 uppercase">
              Location
            </span>
            <span
              class="min-w-0 shrink break-words text-right font-mono text-[15px] tracking-[0.04em] text-ink-300"
            >
              {location}
            </span>
          </div>
        </div>
      </div>

      <BriefForm client:visible />
    </div>
  </div>
</section>
