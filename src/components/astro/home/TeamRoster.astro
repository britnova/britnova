---
/*
 * "Leadership Team" — the real people behind BritNova.
 */
import { Image } from 'astro:assets';
import SectionHeading from '../shared/SectionHeading.astro';
import content from '../../../data/content.json';
import { getTeamImage } from '../../../utils/teamImages';

const { team } = content.home;

/* `photo` is optional per member; cards without one render text-only. */
const members = team.members.map((m) => ({
  ...m,
  portrait: getTeamImage((m as { photo?: string }).photo),
}));
---

<section id="team" class="relative z-10 border-t border-ink-800">
  <div class="mx-auto max-w-[1500px] px-6 py-20 md:px-10 md:py-24">
    <SectionHeading id="team" label={team.heading} />
    <blockquote
      class="font-brand max-w-[18ch] text-[34px] leading-[1.1] font-medium tracking-[-0.03em] text-paper md:text-[50px]"
    >
      {team.quote}
    </blockquote>
    <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        members.map((m) => (
          <div class="border-t border-ink-700 pt-8 text-center">
            {m.portrait && (
              <Image
                src={m.portrait}
                alt={`Portrait of ${m.name}`}
                width={192}
                height={192}
                densities={[1, 2]}
                loading="lazy"
                class="mx-auto mb-6 h-40 w-40 rounded-full object-cover ring-1 ring-ink-700 md:h-48 md:w-48"
              />
            )}
            <p class="font-mono text-[12px] tracking-[0.1em] text-ink-100 uppercase">{m.name}</p>
            <p class="font-brand mt-1.5 text-[18px] font-medium text-paper">{m.role}</p>
            <p class="mt-2 font-mono text-[12px] tracking-[0.08em] text-ink-200 uppercase">
              {m.focus}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
