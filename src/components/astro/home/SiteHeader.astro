---
/*
 * Site header — one nav, same links, same targets, on every page (including
 * the homepage). Rendered two ways: embedded inside Hero's full-height
 * wrapper on the homepage (so the two fill exactly one viewport), and via
 * BaseLayout on every inner page. Either way it's the same component with no
 * per-page variants — mostly static, the only client JS is the inline
 * <script> below, which just toggles the mobile nav disclosure open/closed.
 */
import BrandLogo from './BrandLogo.astro';
import content from '../../../data/content.json';

const { links, ctaLabel, ctaHref } = content.nav;

/*
 * Active-page detection. "/" only matches the homepage exactly (otherwise
 * every route would match); every other link also matches its own
 * sub-routes (e.g. "/work" stays active on "/work/ai-automation"). The
 * active link renders as plain text, not an <a> — there's nothing to
 * navigate to, so clicking it can't trigger a reload.
 */
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="relative z-20 border-b border-ink-800">
  <div class="mx-auto flex max-w-[1500px] items-center justify-between px-6 py-4 md:px-10">
    <a href="/" class="text-[17px] text-paper" aria-label="BritNova Tech — home">
      <BrandLogo id="header" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        links.map((l) =>
          isActive(l.href) ? (
            <span
              aria-current="page"
              class="border-b-2 border-paper font-mono text-[12px] tracking-[0.14em] text-paper uppercase"
            >
              {l.label}
            </span>
          ) : (
            <a
              href={l.href}
              class="border-b-2 border-transparent font-mono text-[12px] tracking-[0.14em] text-ink-300 uppercase transition-colors hover:text-paper"
            >
              {l.label}
            </a>
          )
        )
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={ctaHref}
        class="hidden rounded-sm bg-paper px-4 py-2 font-mono text-[11px] tracking-[0.14em] text-ink-950 uppercase transition-colors hover:bg-ink-200 md:inline-block"
      >
        {ctaLabel}
      </a>

      <button
        type="button"
        id="mobile-nav-toggle"
        class="inline-flex items-center rounded-sm border border-ink-700 px-3 py-2 font-mono text-[11px] tracking-[0.14em] text-ink-300 uppercase transition-colors hover:border-ink-400 hover:text-paper md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <span data-mobile-nav-label>Menu</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav-panel"
    class="absolute inset-x-0 top-full border-b border-ink-800 bg-ink-950 md:hidden"
    hidden
  >
    <nav class="flex flex-col px-6" aria-label="Mobile">
      {
        links.map((l) =>
          isActive(l.href) ? (
            <span
              aria-current="page"
              class="border-b border-ink-800 py-4 font-mono text-[13px] tracking-[0.14em] text-paper uppercase last:border-b-0"
            >
              {l.label}
            </span>
          ) : (
            <a
              href={l.href}
              data-mobile-nav-link
              class="border-b border-ink-800 py-4 font-mono text-[13px] tracking-[0.14em] text-ink-300 uppercase transition-colors last:border-b-0 hover:text-paper"
            >
              {l.label}
            </a>
          )
        )
      }
    </nav>
    <div class="px-6 py-6">
      <a
        href={ctaHref}
        data-mobile-nav-link
        class="block rounded-sm bg-paper px-4 py-3 text-center font-mono text-[11px] tracking-[0.14em] text-ink-950 uppercase transition-colors hover:bg-ink-200"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile nav disclosure — plain open/close UI state, no framework needed.
  // Panel visibility is driven by the `hidden` attribute; `aria-expanded` on
  // the toggle button is the source of truth for open/closed.
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');
  const label = toggle?.querySelector('[data-mobile-nav-label]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
