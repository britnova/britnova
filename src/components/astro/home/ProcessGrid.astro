---
/*
 * "How we work" — a grid of bordered console cells.
 *
 * The seven steps leave one empty cell in the 4-column layout; it is filled
 * with the brand mark rather than left blank.
 *
 * TODO: replace — the process steps are placeholder copy. Confirm them against
 * how the team actually runs an engagement (see src/data/homeContent.ts).
 */
import BrandLogo from './BrandLogo.astro';
import SectionHeading from './SectionHeading.astro';
import { processSteps } from '../../../data/homeContent';
---

<section id="process" class="relative z-10 border-t border-ink-800">
  <div class="mx-auto max-w-[1500px] px-6 py-20 md:px-10 md:py-24">
    <SectionHeading label={`How we work / ${String(processSteps.length).padStart(2, '0')}`} />
    <div class="grid grid-cols-1 border-t border-l border-ink-800 sm:grid-cols-2 lg:grid-cols-4">
      {
        processSteps.map((s, i) => (
          <div class="border-r border-b border-ink-800 p-6 md:p-7">
            <span class="font-mono text-[12px] text-ink-300">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-brand mt-3.5 text-[19px] leading-tight font-medium tracking-[-0.01em] text-paper">
              {s.title}
            </h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-ink-300">{s.detail}</p>
          </div>
        ))
      }
      <div
        class="flex items-center justify-center border-r border-b border-ink-800 p-6 text-[40px] text-ink-700"
      >
        <BrandLogo id="process-mark" wordmark={false} />
      </div>
    </div>
  </div>
</section>
