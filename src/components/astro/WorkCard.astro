---
import { ArrowUpRight } from 'lucide-react';

interface Props {
  title: string;
  description: string;
  slug: string;
  tags: string[];
  client: string;
  year: string;
}

const { title, description, slug, tags, client, year } = Astro.props;
---

<a href={`/work/${slug}`} class="group flex flex-col justify-between p-6 md:p-8 rounded-2xl bg-bg-card border border-border-subtle hover:border-brand-accent/50 hover:bg-bg-card-hover transition-all duration-500 h-full relative overflow-hidden">
  
  <!-- Subtle accent background highlight on hover -->
  <div class="absolute -right-20 -bottom-20 w-64 h-64 rounded-full bg-brand-accent/5 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

  <div>
    <!-- Year and Client -->
    <div class="flex justify-between items-center mb-6 font-mono text-xs text-text-muted">
      <span>{client}</span>
      <span>{year}</span>
    </div>

    <!-- Title -->
    <h3 class="font-display text-2xl font-bold tracking-tight text-text-light mb-3 group-hover:text-brand-accent transition-colors duration-300">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-text-muted leading-relaxed mb-6 font-light">
      {description}
    </p>
  </div>

  <div>
    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-6">
      {tags.map((tag) => (
        <span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded bg-bg-dark border border-border-subtle text-text-muted">
          {tag}
        </span>
      ))}
    </div>

    <!-- Bottom Link indicator -->
    <div class="flex items-center gap-1.5 text-xs font-semibold text-text-light group-hover:text-brand-accent transition-colors duration-300">
      View Case Study
      <ArrowUpRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" />
    </div>
  </div>
</a>
