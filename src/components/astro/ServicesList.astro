---
import { getCollection } from 'astro:content';
import { ArrowUpRight } from 'lucide-react';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
---

<section id="services" class="py-28 border-b border-border-subtle bg-bg-dark">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Section Header -->
    <div class="mb-20 max-w-2xl">
      <h2 class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4">Our Services</h2>
      <h3 class="font-display text-4xl md:text-5xl font-black uppercase tracking-tight text-text-light leading-tight">
        Engineered Solutions for Modern Challenges
      </h3>
    </div>

    <!-- Numbered Alternating List -->
    <div class="flex flex-col">
      {sortedServices.map((service, index) => {
        const num = String(index + 1).padStart(2, '0');
        return (
          <div class="border-t border-border-subtle hover:bg-bg-card/30 transition-colors duration-300 py-12 md:py-16 grid grid-cols-1 md:grid-cols-12 gap-8 items-start group">
            
            <!-- Number -->
            <div class="md:col-span-2 font-mono text-3xl md:text-4xl text-brand-accent/50 group-hover:text-brand-accent transition-colors duration-300 font-bold">
              {num}.
            </div>

            <!-- Title & Description -->
            <div class="md:col-span-6">
              <h4 class="font-display text-2xl md:text-3xl font-bold text-text-light mb-4 group-hover:text-brand-accent transition-colors duration-300 uppercase">
                {service.data.title}
              </h4>
              <p class="text-sm text-text-muted leading-relaxed font-light max-w-xl">
                {service.data.description}
              </p>
            </div>

            <!-- Features & CTA -->
            <div class="md:col-span-4 flex flex-col justify-between h-full min-h-[100px]">
              <ul class="space-y-2 mb-8">
                {service.data.features.map((feature) => (
                  <li class="flex items-center gap-2 text-xs font-mono text-text-muted">
                    <span class="w-1 h-1 rounded-full bg-brand-accent"></span>
                    {feature}
                  </li>
                ))}
              </ul>
              
              <a href={`/services#${service.id}`} class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-text-light group-hover:text-brand-accent transition-colors duration-300 self-start">
                Learn More
                <ArrowUpRight className="w-3.5 h-3.5" />
              </a>
            </div>

          </div>
        );
      })}
      
      <!-- Ending line -->
      <div class="border-t border-border-subtle"></div>
    </div>

  </div>
</section>
