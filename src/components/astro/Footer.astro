---
import { ArrowUpRight } from 'lucide-react';
---

<footer class="bg-bg-dark border-t border-border-subtle pt-24 pb-12">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <!-- Column 1: Brand & Info -->
      <div class="md:col-span-2">
        <a
          href="/"
          class="font-display text-2xl font-bold tracking-tight text-text-light flex items-center gap-2 mb-6"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-brand-accent"></span>
          BRITNOVA
        </a>
        <p class="text-text-muted text-sm max-w-sm leading-relaxed mb-6">
          We design and build high-performance, scalable digital products using AI, Cloud, and
          modern web frameworks.
        </p>
        <div class="flex gap-4">
          <a
            href="mailto:hello@britnova.com"
            class="text-text-light hover:text-brand-accent transition-colors text-sm font-semibold flex items-center gap-1 border-b border-border-subtle hover:border-brand-accent pb-0.5"
          >
            hello@britnova.com
            <ArrowUpRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Column 2: Directory -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-text-muted mb-6">Navigation</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/#work" class="text-text-muted hover:text-text-light transition-colors"
              >Featured Work</a
            >
          </li>
          <li>
            <a href="/#services" class="text-text-muted hover:text-text-light transition-colors"
              >Our Services</a
            >
          </li>
          <li>
            <a href="/about" class="text-text-muted hover:text-text-light transition-colors"
              >About Agency</a
            >
          </li>
          <li>
            <a href="/contact" class="text-text-muted hover:text-text-light transition-colors"
              >Get in Touch</a
            >
          </li>
        </ul>
      </div>

      <!-- Column 3: Socials -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-text-muted mb-6">Socials</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-text-light transition-colors inline-flex items-center gap-1"
            >
              GitHub <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-text-light transition-colors inline-flex items-center gap-1"
            >
              LinkedIn <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li>
            <a
              href="https://twitter.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-text-light transition-colors inline-flex items-center gap-1"
            >
              Twitter <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Line -->
    <div
      class="border-t border-border-subtle pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-text-muted"
    >
      <p>&copy; {new Date().getFullYear()} Britnova Technologies. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-text-light transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-text-light transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
