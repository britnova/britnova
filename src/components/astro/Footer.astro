---
import { ArrowUpRight } from 'lucide-react';
import content from '../../data/content.json';

const { innerFooter } = content.layout;
const { site } = content;
---

<footer class="bg-bg-dark border-t border-border-subtle pt-24 pb-12">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <!-- Column 1: Brand & Info -->
      <div class="md:col-span-2">
        <a
          href="/"
          class="font-display text-2xl font-bold tracking-tight text-text-light flex items-center gap-2 mb-6"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-brand-accent"></span>
          BRITNOVA
        </a>
        <p class="text-text-muted text-sm max-w-sm leading-relaxed mb-6">
          {innerFooter.tagline}
        </p>
        <div class="flex gap-4">
          <a
            href="mailto:hello@britnova.com"
            class="text-text-light hover:text-brand-accent transition-colors text-sm font-semibold flex items-center gap-1 border-b border-border-subtle hover:border-brand-accent pb-0.5"
          >
            hello@britnova.com
            <ArrowUpRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Column 2: Directory -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-text-muted mb-6">
          {innerFooter.navLabel}
        </h4>
        <ul class="space-y-3 text-sm">
          {
            innerFooter.navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-text-muted hover:text-text-light transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Socials -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-text-muted mb-6">
          {innerFooter.socialsLabel}
        </h4>
        <ul class="space-y-3 text-sm">
          {
            innerFooter.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-text-muted hover:text-text-light transition-colors inline-flex items-center gap-1"
                >
                  {social.label} <ArrowUpRight className="w-3 h-3" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Line -->
    <div
      class="border-t border-border-subtle pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-text-muted"
    >
      <p>&copy; {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      <div class="flex gap-6">
        {
          innerFooter.legalLinks.map((link) => (
            <a href={link.href} class="hover:text-text-light transition-colors">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
